# ============================================================================
# RoomSync Environment Configuration (.env.example)
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit `.env` to version control.
# ============================================================================

# 1. Neon PostgreSQL Connection String
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/roomsync?sslmode=require
EXPO_PUBLIC_DATABASE_URL=

# 2. Google OAuth Credentials (Expo AuthSession)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_OAUTH_REDIRECT_SCHEME=roomsync

# 3. Expo Push Notifications
EXPO_PUBLIC_EAS_PROJECT_ID=
PUSH_DISPATCH_WEBHOOK_URL=

# 4. Default Household Seed Config (Optional Override)
EXPO_PUBLIC_DEFAULT_FOOD_PROVIDER=Rox
EXPO_PUBLIC_DEFAULT_MEAL_PRICE_PAISE=8000
